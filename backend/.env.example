# LLM Provider (ollama or gemini)
LLM_PROVIDER=gemini

# ── Ollama Configuration ────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=gemma4:26b-a4b-it-qat
OLLAMA_EMBEDDING_MODEL=qwen3-embedding
OLLAMA_NUM_CTX=32768

# ── Gemini Configuration ────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── Embedding Task Types (Gemini only) ──────────────────────────────────
# Asymmetric task types tell the Gemini embedding model to optimise
# differently for documents vs. queries, improving retrieval accuracy.
EMBEDDING_TASK_TYPE_DOCUMENT=RETRIEVAL_DOCUMENT
EMBEDDING_TASK_TYPE_QUERY=RETRIEVAL_QUERY

# ── Retrieval Pipeline ──────────────────────────────────────────────────
# RETRIEVAL_K: final number of chunks returned to the LLM after reranking.
# RETRIEVAL_K_BEFORE_RERANK: how many candidates to fetch before the
#   cross-encoder reranker selects the top-k. Higher = more accurate but slower.
RETRIEVAL_K=2
RETRIEVAL_K_BEFORE_RERANK=10

# ── Hybrid Search Weights ───────────────────────────────────────────────
# Controls the balance between BM25 (sparse/keyword) and FAISS (dense/semantic)
# in the Reciprocal Rank Fusion step. Must sum to 1.0.
# Increase BM25 weight if queries contain exact terms (codes, IDs, specific values).
# Increase dense weight if queries are natural-language questions.
HYBRID_BM25_WEIGHT=0.4
HYBRID_DENSE_WEIGHT=0.6

# ── Reranker ────────────────────────────────────────────────────────────
# FlashRank cross-encoder model. Lightweight (~4MB), CPU-only, ONNX-based.
# Downloaded automatically on first use.
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2

# ── QA System Prompt ────────────────────────────────────────────────────
QA_SYSTEM_PROMPT="You are a helpful assistant that answers questions using only the provided table context.\nDo not use external knowledge. If the answer is not in the context, say \"I don't have information about that in the provided tables.\"\n\nContext tables:\n{context_table}\n\nQuestion: {query}\n\nAnswer concisely using only the provided table data."
