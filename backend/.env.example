# =============================================================================
# TableRAG Pipeline Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- LLM Provider Selection ---
# Choose which LLM provider to use: "ollama" (local) or "gemini" (cloud)
LLM_PROVIDER=ollama

# --- Ollama Configuration (used when LLM_PROVIDER=ollama) ---

OLLAMA_BASE_URL=http://localhost:11434

# LLM model for QA (must be pulled in Ollama first)
# Pull with: ollama pull gemma4:26b-a4b-it-qat
OLLAMA_LLM_MODEL=gemma4:26b-a4b-it-qat

# Embedding model for vector store (must be pulled in Ollama first)
# Pull with: ollama pull qwen3-embedding
OLLAMA_EMBEDDING_MODEL=qwen3-embedding

# --- Gemini Configuration (used when LLM_PROVIDER=gemini) ---

# GOOGLE_API_KEY=your_google_api_key_here

# Gemini embedding model (default: models/gemini-embedding-001)
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# --- Prompts ---

# QA system prompt — used to answer user questions grounded in table data.
# Placeholders: {context_table}, {query}
QA_SYSTEM_PROMPT=TABLE DATA:\n{context_table}\n\nUsing ONLY the table data above, answer the following question. If the answer is not in the table, say so.\n\nQuestion: {query}

# --- Optional ---

# Number of top results to retrieve from FAISS (default: 1)
RETRIEVAL_K=1

# MinerU binary path override (auto-detected if not set)
# MINERU_BINARY_PATH=/path/to/mineru

# MinerU conversion timeout in seconds (default: 600)
MINERU_TIMEOUT_SECONDS=600
